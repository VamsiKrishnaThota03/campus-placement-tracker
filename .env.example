# Copy to .env and fill in. Never commit .env.

# Flask session/CSRF signing key (required unless FLASK_DEBUG=1)
SECRET_KEY=change-me-to-a-long-random-string
# 1 only for local development
FLASK_DEBUG=0

# Database: either a full URL ...
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/placement_tracker
# ... or the individual parts (used when DATABASE_URL is empty)
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
# With neither set, the web app uses a local SQLite file (web/placements.db).

# Used only by `flask --app app init-db` to create the first admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional
PORT=5001
SESSION_COOKIE_SECURE=
# Offline analysis script (src/analyze_placements.py); falls back to DATABASE_URL / DB_*
ANALYSIS_DATABASE_URL=
REPORTS_DIR=
